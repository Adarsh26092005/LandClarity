{
  "name": "landclarity-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "LandClarity: Unified AI-powered, GIS-enabled and Blockchain-backed Digital Land Ecosystem",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:ai": "cd apps/ai-service && python main.py",
    "lint": "npm run lint --workspaces --if-present",
    "verify": "node scripts/verify-environment.js"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
