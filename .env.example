# ==============================================================================
# LandClarity Unified Environment Template
# Copy this file to .env before starting services for local development
# ==============================================================================

# NODE ENVIRONMENT
NODE_ENV=development

# ------------------------------------------------------------------------------
# BACKEND (NestJS API) - apps/api
# ------------------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# DATABASE (PostgreSQL + PostGIS)
DATABASE_URL="postgresql://landclarity_user:landclarity_secure_pass@localhost:5432/landclarity_db?schema=public"
DB_HOST=localhost
DB_PORT=5432
DB_USER=landclarity_user
DB_PASSWORD=landclarity_secure_pass
DB_NAME=landclarity_db

# REDIS CACHE & BULLMQ QUEUES
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# SECURITY & AUTHENTICATION
JWT_ACCESS_SECRET="landclarity_access_jwt_super_secret_key_change_in_production_32chars"
JWT_REFRESH_SECRET="landclarity_refresh_jwt_super_secret_key_change_in_production_32chars"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# OBJECT STORAGE (MinIO / S3 Compatible)
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=landclarity_minio_admin
STORAGE_SECRET_KEY=landclarity_minio_secret_password
STORAGE_BUCKET_DOCUMENTS=landclarity-documents

# AI SERVICE INTEGRATION
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY="lc_ai_dev_shared_internal_secret_key"

# ------------------------------------------------------------------------------
# FRONTEND (Vite + React) - apps/web
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:4000
VITE_AI_SERVICE_URL=http://localhost:8000
VITE_MAP_DEFAULT_CENTER_LNG=77.2090
VITE_MAP_DEFAULT_CENTER_LAT=28.6139
VITE_MAP_DEFAULT_ZOOM=12
VITE_MAP_STYLE_URL="https://demotiles.maplibre.org/style.json"

# ------------------------------------------------------------------------------
# AI SERVICE (FastAPI) - apps/ai-service
# ------------------------------------------------------------------------------
AI_PORT=8000
AI_HOST=0.0.0.0
AI_SECRET_KEY="lc_ai_dev_shared_internal_secret_key"
OCR_ENGINE=paddleocr
LLM_PROVIDER=local_or_mock
OPENAI_API_KEY=
